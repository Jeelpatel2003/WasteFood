@{
    ViewData["Title"] = "Waste Food Services";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Our Waste Food Services</h2>

    <div class="row mb-5">
        <div class="col-md-6">
            <img src="~/images/food_donation.jpg" alt="Food Donation" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-6 d-flex align-items-center">
            <div>
                <h4>Food Donation</h4>
                <p>We allow individuals and businesses to donate excess or leftover food that is still fresh and edible. Our platform ensures that the food reaches those in need.</p>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-6 order-md-2">
            <img src="~/images/food_pickup.jpg" alt="Food Pickup" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-6 order-md-1 d-flex align-items-center">
            <div>
                <h4>Food Pickup</h4>
                <p>Our volunteers and staff coordinate timely pickups of food donations from registered donors to ensure efficient collection and reduced food wastage.</p>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-6">
            <img src="~/images/food_distribution.jpg" alt="Food Distribution" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-6 d-flex align-items-center">
            <div>
                <h4>Food Distribution</h4>
                <p>The collected food is distributed to homeless shelters, orphanages, and areas affected by poverty and hunger. Our goal is to feed every empty plate.</p>
            </div>
        </div>
    </div>
</div>
