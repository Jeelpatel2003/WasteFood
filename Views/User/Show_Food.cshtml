@model IEnumerable<WasteFood.Models.Entities.Food_Donation>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Food Donation List";
    Layout = null;
}

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Waste Food Management System</title>
    <style>
        /* Simple Reset and basic styles */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f9f9f9;
            color: #333;
            display: flex;
            min-height: 100vh;
        }

        /* Left Sidebar */
        #leftsidebar {
            width: 220px;
            background: #2c3e50;
            color: white;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

            #leftsidebar .navbar-brand {
                padding: 15px;
                font-weight: bold;
                font-size: 18px;
                border-bottom: 1px solid #34495e;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                #leftsidebar .navbar-brand img {
                    width: 25px;
                }

            #leftsidebar .user-info {
                padding: 15px;
                border-bottom: 1px solid #34495e;
                text-align: center;
            }

                #leftsidebar .user-info img {
                    border-radius: 50%;
                    width: 60px;
                    height: 60px;
                    object-fit: cover;
                }

                #leftsidebar .user-info h4 {
                    margin: 10px 0 0 0;
                    font-weight: normal;
                }

            #leftsidebar ul.list {
                list-style: none;
                padding: 0;
                margin: 0;
                flex-grow: 1;
            }

                #leftsidebar ul.list li {
                    border-bottom: 1px solid #34495e;
                }

                    #leftsidebar ul.list li a {
                        display: block;
                        padding: 12px 20px;
                        color: white;
                        text-decoration: none;
                        font-size: 14px;
                    }

                        #leftsidebar ul.list li a:hover,
                        #leftsidebar ul.list li.active > a {
                            background-color: #1abc9c;
                        }

                    #leftsidebar ul.list li ul.ml-menu {
                        background: #34495e;
                        list-style: none;
                        padding-left: 15px;
                        display: none;
                    }

                    #leftsidebar ul.list li.menu-toggle:hover + ul.ml-menu,
                    #leftsidebar ul.list li.menu-toggle:focus + ul.ml-menu,
                    #leftsidebar ul.list li.open > ul.ml-menu {
                        display: block;
                    }

                    #leftsidebar ul.list li ul.ml-menu li a {
                        font-size: 13px;
                        padding-left: 30px;
                    }

        /* Main content */
        .content {
            flex-grow: 1;
            padding: 20px;
            background: white;
            margin: 20px;
            border-radius: 4px;
            box-shadow: 0 0 6px rgba(0, 0, 0, 0.1);
            max-width: calc(100% - 280px);
        }

        h2 {
            margin-top: 0;
            color: #2980b9;
            text-align: center;
        }

        .btn {
            display: inline-block;
            padding: 8px 16px;
            margin-bottom: 15px;
            text-decoration: none;
            background-color: #2980b9;
            color: white;
            border-radius: 3px;
            font-size: 14px;
            cursor: pointer;
        }

            .btn:hover {
                background-color: #3498db;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th,
        td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
            vertical-align: middle;
            font-size: 14px;
        }

        th {
            background-color: #ecf0f1;
        }

        img.food-image {
            max-height: 80px;
            max-width: 100px;
            object-fit: cover;
            border-radius: 4px;
        }

        .alert-success {
            padding: 10px;
            background-color: #2ecc71;
            color: white;
            margin-bottom: 15px;
            border-radius: 3px;
        }

        form {
            display: inline;
        }

        button.btn-danger {
            background-color: #e74c3c;
            border: none;
            padding: 6px 12px;
            color: white;
            border-radius: 3px;
            cursor: pointer;
            font-size: 13px;
        }

            button.btn-danger:hover {
                background-color: #c0392b;
            }

        a.btn-warning {
            background-color: #f39c12;
            color: white;
            padding: 6px 12px;
            border-radius: 3px;
            font-size: 13px;
            text-decoration: none;
            cursor: pointer;
        }

            a.btn-warning:hover {
                background-color: #d68910;
            }
    </style>
</head>

<body>

    <aside id="leftsidebar" class="sidebar">
        <div class="navbar-brand">
            <img src="~/assets/images/logo.svg" alt="Logo" />
            <span>WFMS</span>
        </div>
        <div class="user-info">
            <img src="~/assets/images/profile_av.jpg" alt="User" />
            <h4>User</h4>
        </div>
        <ul class="list">
            <li class="active"><a href="/User/Cdashboard">Dashboard</a></li>
        </ul>
    </aside>

    <section class="content">
        <h2>Food List</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success">@TempData["Success"]</div>
        }

        <table>
            <thead>
                <tr>
                    <th>Food Name</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Pickup Address</th>
                    <th>Contact No</th>
                    <th>Status</th>
                    <th>Image</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var Food_Donation in Model)
                {
                    <tr>
                        <td>@Food_Donation.Food_Name</td>
                        <td>@Food_Donation.Food_Description</td>
                        <td>@Food_Donation.Quantity</td>
                        <td>@Food_Donation.PickupAddress</td>
                        <td>@Food_Donation.ContactNo</td>
                        <td>@Food_Donation.Status</td>
                        <td>
                            @if (!string.IsNullOrEmpty(Food_Donation.ImagePath))
                            {
                                <img class="food-image" src="@Food_Donation.ImagePath" alt="Food Image" />
                            }
                            else
                            {
                                <span>No Image</span>
                            }
                        </td>
                        <td>
                            <a class="btn btn-primary" asp-controller="User" asp-action="Food_Request" asp-route-id="@Food_Donation.DonationId">Apply</a>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </section>

</body>

</html>
