    <!-- Your sidebar and header code remains unchanged -->
    <!-- Main Content -->
    <section class="content">
        <div class="container mt-5">
            <div class="row clearfix justify-content-center">
                <div class="col-lg-8 col-md-10 col-sm-12">
                    <div class="card">
                        <h2>Add Food Donation</h2>
                        <form asp-action="AddFood_Donation" method="post" enctype="multipart/form-data">
                            <div>
                                <label>Donor ID:</label>
                                <input asp-for="D_Id" class="form-control" />
                                <span asp-validation-for="D_Id" class="text-danger"></span>
                            </div>
                            <div>
                                <label>Food Name:</label>
                                <input asp-for="Food_Name" class="form-control" />
                                <span asp-validation-for="Food_Name" class="text-danger"></span>
                            </div>
                            <div>
                                <label>Description:</label>
                                <input asp-for="Food_Description" class="form-control" />
                                <span asp-validation-for="Food_Description" class="text-danger"></span>
                            </div>
                            <div>
                                <label>Quantity:</label>
                                <input asp-for="Quantity" class="form-control" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>
                            <div>
                                <label>Pickup Address:</label>
                                <input asp-for="PickupAddress" class="form-control" />
                                <span asp-validation-for="PickupAddress" class="text-danger"></span>
                            </div>
                            <div>
                                <label>Contact Number:</label>
                                <input asp-for="ContactNumber" class="form-control" />
                                <span asp-validation-for="ContactNumber" class="text-danger"></span>
                            </div>
                            <div>
                                <label>Status:</label>
                                <input asp-for="Status" class="form-control" />
                            </div>
                            <div>
                                <label>Food Image:</label>
                                <input type="file" name="FoodImage" class="form-control" />
                            </div>
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </section>

